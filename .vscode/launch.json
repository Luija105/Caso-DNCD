{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API DNCD",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/ApiDncdCaso/bin/Debug/net10.0/ApiDncdCaso.dll",
            "args": [],
            "cwd": "${workspaceFolder}/ApiDncdCaso",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "WinForms DNCD",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/MiAplicacionWinForms/bin/Debug/net10.0-windows/MiAplicacionWinForms.dll",
            "args": [],
            "cwd": "${workspaceFolder}/MiAplicacionWinForms",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ],
    "compounds": [
        {
            "name": "API + WinForms DNCD",
            "configurations": [
